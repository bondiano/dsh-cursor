{
  "name": "@local/dsh-cursor",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Cursor models in DeepSeek Harness: browser sign-in, DSH-owned tools, model editor, subscription quota windows and a composer usage pill.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "dist/**/*.js",
    "!dist/test/",
    "index.ts",
    "client.ts",
    "cordis.patch.yml",
    "locale",
    "docs",
    "README.md",
    "NOTICE",
    "icon.svg",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@cursor/sdk": "1.3.1",
    "ajv": "^8.20.0",
    "xstate": "5.33.4",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": ">=0.2.2-rc.3",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.3",
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bondiano/dsh-cursor.git"
  },
  "homepage": "https://github.com/bondiano/dsh-cursor#readme",
  "bugs": {
    "url": "https://github.com/bondiano/dsh-cursor/issues"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "7.0.2"
  }
}
